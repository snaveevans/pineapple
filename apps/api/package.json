{
  "name": "@snaveevans/pineapple-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var ENVIRONMENT:development --inspector-port 9230",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "cf-typegen": "wrangler types --strict-vars=false --env-file .env.typegen"
  },
  "dependencies": {
    "@better-auth/core": "1.7.5",
    "@better-auth/mcp": "^1.7.5",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.2",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@scalar/hono-api-reference": "^0.12.0",
    "@snaveevans/pineapple-shared": "workspace:*",
    "better-auth": "^1.7.5",
    "better-auth-cloudflare": "^0.3.1",
    "better-call": "1.4.0",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11",
    "wrangler": "^4.120.0"
  }
}
