{
  "name": "@snaveevans/pineapple-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var ENVIRONMENT:development --inspector-port 9230",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "cf-typegen": "wrangler types --strict-vars=false --env-file .env.typegen"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.3",
    "@scalar/hono-api-reference": "^0.11.11",
    "@snaveevans/pineapple-shared": "workspace:*",
    "better-auth": "^1.6.26",
    "better-auth-cloudflare": "^0.3.1",
    "hono": "^4.12.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "tsx": "^4.23.9",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
