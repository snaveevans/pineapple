{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    // Workers runtime globals (D1Database, Queue, AnalyticsEngineDataset, …) come
    // from the generated worker-configuration.d.ts below, which supersedes
    // @cloudflare/workers-types (see `wrangler types`). Keep only non-Workers ambient types here.
    "types": ["vitest/globals"],
    "lib": ["ESNext"]
  },
  // worker-configuration.d.ts is generated by `wrangler types` (cf-typegen script)
  // and committed; it provides the global `Cloudflare.Env` and the Workers runtime types.
  "include": ["src/**/*.ts", "vitest.config.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules"]
}
