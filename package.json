{
  "name": "@snaveevans/pineapple-root",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "kill-ports": "lsof -ti:8787,5173,9229,9230 | xargs kill -9 2>/dev/null || true",
    "dev": "pnpm -r --parallel --filter @snaveevans/pineapple-api --filter @snaveevans/pineapple-web run dev",
    "lint": "eslint . && pnpm run lint:css",
    "lint:css": "stylelint \"apps/web/src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r --if-present run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm type-check && pnpm -r test && pnpm --filter @snaveevans/pineapple-api openapi:generate && git diff --exit-code docs/reference/openapi.json && pnpm --filter @snaveevans/pineapple-api cf-typegen && git diff --exit-code apps/api/worker-configuration.d.ts && pnpm --filter @snaveevans/pineapple-web api:types && git diff --exit-code apps/web/src/api/schema.ts",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Tyler Evans",
  "packageManager": "pnpm@10.28.2",
  "lint-staged": {
    "**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,yaml,md,cjs,mjs}": [
      "prettier --write"
    ],
    "apps/web/src/**/*.css": [
      "stylelint"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-n": "^18.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
